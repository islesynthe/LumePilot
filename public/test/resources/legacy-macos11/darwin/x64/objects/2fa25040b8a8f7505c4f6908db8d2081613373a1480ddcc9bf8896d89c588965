 main checklist quote candidates",description:"Keeps multiple quotation options before signing and selects the final option at signing. Current quotation rules are unchanged."}},templates:{editorLocation:"Create and edit templates in System Settings → Template Configuration. The setup wizard does not include a template editor.",backupPath:"Use “Export template backup” in Template Configuration, then upload that file here for validation. “Export JSON” is not the recommended setup import path.",noDefaults:"No default templates are bundled at this stage. Create templates later in System Settings or import a validated template backup.",systemSettingsNote:"Create and edit templates on this page. The wizard prioritizes backups exported here, records only an import summary, and does not perform a restore.",statusTitle:"Template status summary",slots:{quote:"Quote Template",afterSales:"After-sales Template",settlement:"Settlement Template"},multiSlotHelper:"Upload quote, after-sales, and settlement template backups separately. Only the import summary is recorded. The actual template configuration is not replaced automatically.",unclassifiedLegacy:"An older import record could not be classified. Upload each template backup again. The older record has not been deleted.",importStatus:"Backup import status",applied:"Import summary applied",notApplied:"Not imported",appliedAt:"Last applied",sourceFile:"Source file",templateName:"Template name",sourceFormat:"Source format",sourceFormats:{nativeTemplateBackup:"Template backup",manifestV1:"Compatible manifest",legacyJson:"Legacy JSON"},templateCount:"Template count",uploadLabel:"Upload template backup file",uploadHelper:"Template backup JSON files up to 1 MB are accepted. Files are validated before they can be applied.",validationPassed:"The file structure passed validation and its import summary can be applied.",validatedTitle:"Pending backup summary",templateCountSummary:"{count} template records",apply:"Apply backup",appliedSuccess:"The template backup import summary was applied in this browser.",applyFailed:"The template backup import summary could not be saved. Check browser storage permissions.",clear:"Clear import record",cleared:"The template backup import record was cleared.",clearFailed:"The template backup import record could not be cleared.",types:{quote:"Quote template",cost:"Cost template",settlement:"Settlement template",other:"Other template"},validation:{fileRequired:"Select a template backup file.",fileTooLarge:"The file exceeds the 1 MB limit.",jsonFileRequired:"Select a JSON template backup file.",invalidJson:"The file is not valid JSON.",invalidRoot:"The backup root must be a JSON object.",invalidNativeBackup:"The template backup is incomplete and cannot be recognized by the existing restore rules.",unsupportedNativeBackup:"This template backup version is not supported.",unsupportedFormat:"This is not a supported template backup. Use “Export template backup” to create the file.",unsupportedSchema:"This compatible manifest format is unsupported. Prefer a file created with “Export template backup”.",unsupportedTemplateSlot:"The file cannot be identified as a quote, after-sales, or settlement template backup.",multipleSlotsUnsupported:"This compatible file contains multiple template types. Upload each backup through its matching template card.",slotMismatch:"This backup belongs to “{source}” and cannot be applied to “{expected}”.",templatesRequired:"templates must be an array.",invalidTemplateId:"Template {index} does not have a valid templateId.",duplicateTemplateId:"Template {index} has a duplicate templateId.",invalidTemplateType:"Template {index} has an unsupported templateType.",invalidDisplayName:"Template {index} does not have a valid displayName.",invalidOptionalField:"Template {index} has an invalid version, locale, or engine.",invalidMetadata:"Template {index} metadata must be a plain JSON object."}},fonts:{entry:"Formal entry: System Settings → Font Assets",note:"Font uploads, brand assets, logos and PDF / template usage remain in existing management pages. This wizard does not import or share resource files."},cloud:{status:"Default status: local mode. Cloud can be enabled explicitly after setup from Data & Sync.",provider:"Default provider: local-only. This wizard does not request Cloud credentials.",diagnostics:"After setup, the Test Center can explicitly run redacted diagnostics for a bound DEV / TEST provider.",note:"This wizard does not connect to a provider, upload data, save secrets or access the network."},help:{status:"Planned",note:"Help topics resolve through the shared registry. This step browses only stable helpTopicId values, summaries and planned status; it hard-codes no document path and provides no full help content."},diagnostics:{status:"The diagnostics registry is connected. Cloud diagnostics are explicitly runnable from the Test Center after setup.",future:"Other items below remain command references or planning metadata; only the Cloud item has a live DEV / TEST provider runner.",source:"This wizard only shows entry and registry information. It does not run tests or network checks itself.",safety:"Write-based, destructive and high-risk tests are hidden or disabled in production by default."},configurationCheck:{note:"This check is read-only: it does not repair, migrate or write configuration. Using defaults and not importing templates are not errors and do not block completion."},highRisk:{title:"High-risk items (read-only / dedicated flow)",fieldIds:"Field stableId / fieldDefinitionId",costItem:"stableCostItemId semantics",flowTypes:"Project Flow stageType / taskType semantics",history:"Migration of signed / exported / settled historical configuration",criticalRoles:"System roles / critical capabilities",cloudProvider:"Cloud provider switching",backup:"Backup restore",customer:"Customer deletion / merge",historyRepair:"Unsign / historical repair"},costProtection:{title:"Cost Protection",global:"Enable